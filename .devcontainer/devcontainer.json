{
  "name": "GRIDLAB",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  // Ставим зависимости один раз при создании контейнера.
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",

  // Терминал поднимается сам, порт пробрасывается наружу с публичной ссылкой.
  "postAttachCommand": "python run.py",

  "forwardPorts": [8100],
  "portsAttributes": {
    "8100": {
      "label": "GRIDLAB",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
