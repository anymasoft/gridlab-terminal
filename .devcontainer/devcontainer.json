{
  "name": "GRIDLAB",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  // Зависимости ставятся один раз при создании контейнера.
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",

  // Старт при каждом запуске контейнера. Именно postStartCommand, а не
  // postAttachCommand: его выполняет агент Codespaces, независимо от того,
  // подключился ли редактор и доверяет ли он папке.
  // nohup + фон, чтобы команда не блокировала запуск контейнера.
  "postStartCommand": "nohup python run.py > /tmp/gridlab.log 2>&1 &",

  "forwardPorts": [8100],
  "portsAttributes": {
    "8100": {
      "label": "GRIDLAB",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        // Без этого редактор стартует в ограниченном режиме и блокирует автозапуск.
        "security.workspace.trust.enabled": false
      }
    }
  }
}
