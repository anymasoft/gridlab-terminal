# ======================================================================
# GRIDLAB — конфигурация (.env). Скопируй в .env. НЕ коммить в публичный git.
# Терминал работает БЕЗ единого ключа на реальных ценах Bybit (keyless v5).
# Ключи нужны только для режима Testnet (исполнение на тестовой бирже).
# ======================================================================

# ---------- Площадка исполнения ----------
# paper   = бумажный матчинг-движок (по умолчанию, реальные цены Bybit mainnet)
# testnet = исполнение на Bybit Testnet (нужны ключи ниже)
VENUE=paper

# ---------- Bybit ----------
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_TESTNET_URL=https://api-testnet.bybit.com
BYBIT_CATEGORY=linear
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# ---------- Модель издержек (как на реальном Bybit, perpetual VIP0) ----------
MAKER_FEE_BPS=2.0          # 0.020% — лимитные grid-ордера (maker)
TAKER_FEE_BPS=5.5          # 0.055% — TP/SL/ликвидация (taker / market)
SLIPPAGE_BPS=1.0           # проскальзывание market-исполнения
LATENCY_MS=250             # задержка постановки/исполнения
LEVERAGE=3.0               # плечо (маржа = notional / leverage)
LIQ_MAINT_MARGIN_BPS=50.0  # поддерживающая маржа 0.5% (порог ликвидации)
FUNDING_INTERVAL_H=8       # период funding-платежей

# ---------- Параметры исследования ----------
START_CAPITAL=1000
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,POLUSDT,ARBUSDT
DEFAULT_INTERVAL=15        # 1,5,15,60,240 (минуты)
HISTORY_BARS=1000          # сколько свечей тянуть на инструмент

# ---------- Хранилище ----------
DB_PATH=data/gridlab.db
